<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Edit a reply in the BookNook discussion forum.">
    <title>BookNook | Edit Reply</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/forum.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container form-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/forum-main">Forum</a> / <a href="/forum-topic/<%= topic.id %>"><%= topic.title %></a> / Edit reply
        </nav>

        <section class="topic-form-card" aria-labelledby="form-title">
            <h1 id="form-title">Edit reply</h1>
            <p>Update the title, message and image of your reply.</p>
            <p id="reply-form-message" class="form-message" role="alert" aria-live="polite"><%= Object.keys(errors).length ? 'Please correct the highlighted fields.' : '' %></p>

            <form id="reply-form" method="post"
                data-draft-key="booknookForumReply:edit:<%= topic.id %>:<%= formData.id %>"
                data-load-draft="<%= Object.keys(errors).length === 0 %>" novalidate>
                <div class="form-field">
                    <label for="reply-title">Reply title</label>
                    <input id="reply-title" name="title" type="text" minlength="3" maxlength="100"
                        value="<%= formData.title || '' %>" required>
                    <p class="field-help"><span id="reply-title-count">0</span> / 100 characters</p>
                    <p id="reply-title-error" class="field-error" aria-live="polite"><%= errors.title || '' %></p>
                </div>
                <div class="form-field">
                    <label for="reply-message">Your message</label>
                    <textarea id="reply-message" name="content" rows="7" minlength="3" maxlength="1000" required><%= formData.content || '' %></textarea>
                    <p class="field-help"><span id="reply-message-count">0</span> / 1000 characters</p>
                    <p id="reply-content-error" class="field-error" aria-live="polite"><%= errors.content || '' %></p>
                </div>
                <div class="form-field">
                    <label for="reply-image">Image</label>
                    <select id="reply-image" name="image" required>
                        <option value="">Choose an image</option>
                        <% forumImages.forEach((image) => { %>
                            <option value="<%= image.value %>" <%= formData.image === image.value ? 'selected' : '' %>><%= image.label %></option>
                        <% }) %>
                    </select>
                    <p id="reply-image-error" class="field-error" aria-live="polite"><%= errors.image || '' %></p>
                </div>
                <div class="form-actions">
                    <a class="secondary-button" href="/forum-topic/<%= topic.id %>#reply-<%= formData.id %>">Cancel</a>
                    <button id="clear-reply-draft" class="secondary-button" type="button">Reset form</button>
                    <button class="button" type="submit">Save changes</button>
                </div>
            </form>
        </section>
    </main>

    <%- include("partials/footer") %>
    <script src="/js/navbar.js"></script>
    <script src="/js/forum-reply.js"></script>
</body>

</html>
