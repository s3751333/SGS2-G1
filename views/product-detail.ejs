<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Product details and customer reviews for <%= product.name %> on BookNook.">
    <title>BookNook | <%= product.name %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/product-detail.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> / <a href="/products">Shop</a> / <a href="/products?category=<%= product.category %>"><%= product.tag %></a> / <%= product.name %>
        </nav>

        <section class="product-overview">
            <div class="product-gallery">
                <img src="<%= product.image %>" alt="Cover of <%= product.name %>">
            </div>

            <div class="product-info">
                <span class="tag"><%= product.tag %></span>
                <h1><%= product.name %></h1>
                <p class="product-author"><%= product.metaLabel %>: <%= product.meta %></p>

                <div class="rating-line">
                    <% if (rating.count > 0) { %>
                        <span class="stars" aria-hidden="true"><%- "&#9733;".repeat(Math.round(rating.average)) + "&#9734;".repeat(5 - Math.round(rating.average)) %></span>
                        <span><%= rating.average %> out of 5</span>
                        <a href="#reviews"><%= rating.count %> review<%= rating.count === 1 ? "" : "s" %></a>
                    <% } else { %>
                        <span>No reviews yet</span>
                        <a href="#write-review">Be the first to review</a>
                    <% } %>
                </div>

                <p class="product-price"><%= product.price.toLocaleString("vi-VN") %> VND</p>
                <p class="stock-status">
                    <% if (product.stock > 0) { %>
                        <i class="fas fa-circle-check"></i> In stock &mdash; <%= product.stock %> copies left
                    <% } else { %>
                        <i class="fas fa-circle-xmark"></i> Out of stock
                    <% } %>
                </p>

                <p class="product-description"><%= product.description %></p>

                <div class="purchase-row">
                    <div class="qty-selector" aria-label="Quantity">
                        <button type="button" data-quantity-decrease aria-label="Decrease quantity">&minus;</button>
                        <span data-product-quantity aria-live="polite">1</span>
                        <button type="button" data-quantity-increase aria-label="Increase quantity">+</button>
                    </div>
                    <a href="/cart" class="button" data-add-to-cart="<%= product.id %>"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <% if (currentUser) { %>
                        <button type="button" class="secondary-button <%= isInWishlist ? "is-saved" : "" %>" data-wishlist-toggle data-product-id="<%= product.id %>" data-saved="<%= isInWishlist %>">
                            <i class="<%= isInWishlist ? "fas" : "far" %> fa-heart"></i>
                            <span data-wishlist-label><%= isInWishlist ? "Saved to Wishlist" : "Add to Wishlist" %></span>
                        </button>
                    <% } else { %>
                        <a href="/login?next=<%= encodeURIComponent(`/product-detail/${product.id}`) %>" class="secondary-button"><i class="far fa-heart"></i> Add to Wishlist</a>
                    <% } %>
                </div>

                <div class="spec-card">
                    <h2>Product Specifications</h2>
                    <table class="spec-table">
                        <% product.specs.forEach((spec) => { %>
                            <tr>
                                <th scope="row"><%= spec.label %></th>
                                <td><%= spec.value %></td>
                            </tr>
                        <% }) %>
                    </table>
                </div>
            </div>
        </section>

        <section class="reviews-section" id="reviews" aria-labelledby="reviews-heading">
            <h2 class="section-title" id="reviews-heading">Customer Reviews</h2>

            <div class="review-summary">
                <div class="summary-score">
                    <span class="score"><%= rating.average %></span>
                    <span class="stars" aria-hidden="true"><%- "&#9733;".repeat(Math.round(rating.average)) + "&#9734;".repeat(5 - Math.round(rating.average)) %></span>
                    <p>Based on <%= rating.count %> review<%= rating.count === 1 ? "" : "s" %></p>
                </div>
                <div class="rating-bars">
                    <% rating.breakdown.forEach((row) => { %>
                        <div class="rating-bar-row">
                            <span><%= row.stars %> star<%= row.stars === 1 ? "" : "s" %></span>
                            <div class="rating-bar-track"><div class="rating-bar-fill" style="width: <%= row.percent %>%;"></div></div>
                            <span><%= row.percent %>%</span>
                        </div>
                    <% }) %>
                </div>
            </div>

            <div class="review-tools">
                <label for="review-sort">Sort by</label>
                <select id="review-sort" data-review-sort>
                    <option value="recent" <%= reviewSort === "recent" ? "selected" : "" %>>Newest first</option>
                    <option value="helpful" <%= reviewSort === "helpful" ? "selected" : "" %>>Most helpful</option>
                </select>
            </div>

            <div class="review-list">
                <% if (reviews.length === 0) { %>
                    <p class="no-reviews">No reviews yet for this product. Be the first to share your thoughts below.</p>
                <% } %>
                <% reviews.forEach((review) => { %>
                    <article class="review-card" data-review-id="<%= review.id %>">
                        <div class="review-header">
                            <div>
                                <span class="reviewer-name"><%= review.authorName %></span>
                                <% if (review.userId) { %>
                                    <span class="verified-badge"><i class="fas fa-circle-check"></i> Verified Member</span>
                                <% } %>
                            </div>
                            <span class="review-date"><%= new Date(review.createdAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) %></span>
                        </div>
                        <span class="stars" aria-hidden="true"><%- "&#9733;".repeat(review.rating) + "&#9734;".repeat(5 - review.rating) %></span>
                        <h3 class="review-title"><%= review.title %></h3>
                        <p class="review-body"><%= review.body %></p>
                        <div class="review-footer">
                            <button type="button" class="helpful-btn" data-helpful-button data-product-id="<%= product.id %>" data-review-id="<%= review.id %>">
                                <i class="far fa-thumbs-up"></i> Helpful (<span data-helpful-count><%= review.helpfulCount %></span>)
                            </button>
                            <% if (review.isOwnReview) { %>
                                <form action="/product-detail/<%= product.id %>/reviews/<%= review.id %>/delete" method="post" data-confirm-delete="Delete your review?">
                                    <button type="submit" class="delete-review-btn"><i class="far fa-trash-can"></i> Delete</button>
                                </form>
                            <% } %>
                        </div>
                    </article>
                <% }) %>
            </div>

            <% if (currentUser) { %>
                <div class="review-form-card" id="write-review" aria-labelledby="review-form-heading">
                    <h2 id="review-form-heading">Write a Review</h2>
                    <p>Share your thoughts with other BookNook readers.</p>
                    <% if (reviewErrors.duplicate) { %>
                        <p class="form-error"><%= reviewErrors.duplicate %></p>
                    <% } %>
                    <form id="review-form" action="/product-detail/<%= product.id %>/reviews" method="post" novalidate>
                        <div>
                            <span id="rating-label">Your rating</span>
                            <div class="star-picker" role="radiogroup" aria-labelledby="rating-label">
                                <input type="radio" id="rating-5" name="rating" value="5" <%= reviewFormData.rating === "5" ? "checked" : "" %>>
                                <label for="rating-5" title="5 stars">&#9733;</label>
                                <input type="radio" id="rating-4" name="rating" value="4" <%= reviewFormData.rating === "4" ? "checked" : "" %>>
                                <label for="rating-4" title="4 stars">&#9733;</label>
                                <input type="radio" id="rating-3" name="rating" value="3" <%= reviewFormData.rating === "3" ? "checked" : "" %>>
                                <label for="rating-3" title="3 stars">&#9733;</label>
                                <input type="radio" id="rating-2" name="rating" value="2" <%= reviewFormData.rating === "2" ? "checked" : "" %>>
                                <label for="rating-2" title="2 stars">&#9733;</label>
                                <input type="radio" id="rating-1" name="rating" value="1" <%= reviewFormData.rating === "1" ? "checked" : "" %>>
                                <label for="rating-1" title="1 star">&#9733;</label>
                            </div>
                            <p class="field-error" data-error-for="rating"><%= reviewErrors.rating || "" %></p>
                        </div>
                        <div>
                            <label for="review-title">Review title</label>
                            <input type="text" id="review-title" name="title" placeholder="Sum up your review in a few words" value="<%= reviewFormData.title %>" maxlength="120" required>
                            <p class="field-error" data-error-for="title"><%= reviewErrors.title || "" %></p>
                        </div>
                        <div>
                            <label for="review-body">Your review</label>
                            <textarea id="review-body" name="body" rows="5" placeholder="What did you like or dislike about this product? (10-1000 characters)" maxlength="1000" required><%= reviewFormData.body %></textarea>
                            <p class="field-error" data-error-for="body"><%= reviewErrors.body || "" %></p>
                        </div>
                        <button class="button" type="submit">Submit Review</button>
                    </form>
                </div>
            <% } else { %>
                <div class="review-form-card" id="write-review">
                    <p><a href="/login?next=<%= encodeURIComponent(`/product-detail/${product.id}#write-review`) %>">Sign in</a> to write a review.</p>
                </div>
            <% } %>
        </section>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/store.js" defer></script>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/product-detail.js" defer></script>
</body>

</html>
