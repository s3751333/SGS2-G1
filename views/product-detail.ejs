<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Product details and customer reviews for The Little Prince on BookNook.">
    <title>BookNook | The Little Prince</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/product-detail.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> / <a href="products">Shop</a> / <a href="products#fiction">Fiction</a> / The Little Prince
        </nav>

        <section class="product-overview">
            <div class="product-gallery">
                <img src="img/little_prince.jpg" alt="Cover of The Little Prince">
            </div>

            <div class="product-info">
                <span class="tag">Fiction</span>
                <h1>The Little Prince</h1>
                <p class="product-author">by Antoine de Saint-Exupéry &middot; Richard Howard translation</p>

                <div class="rating-line">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    <span>4.6 out of 5</span>
                    <a href="#reviews">128 reviews</a>
                </div>

                <p class="product-price">100,000 VND</p>
                <p class="stock-status"><i class="fas fa-circle-check"></i> In stock &mdash; 24 copies left</p>

                <p class="product-description">
                    A poetic tale of a young prince who leaves his tiny home planet to journey across the
                    universe, meeting a fox, a rose, and a stranded pilot along the way. This edition uses
                    Richard Howard's modern English translation, praised for its clarity and warmth &mdash; a
                    great pick for both first-time readers and long-time fans revisiting the story.
                </p>

                <div class="purchase-row">
                    <div class="qty-selector" aria-label="Quantity">
                        <button type="button" aria-label="Decrease quantity">&minus;</button>
                        <span>1</span>
                        <button type="button" aria-label="Increase quantity">+</button>
                    </div>
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i> Add to Wishlist</a>
                </div>

                <div class="spec-card">
                    <h2>Product Specifications</h2>
                    <table class="spec-table">
                        <tr>
                            <th scope="row">ISBN</th>
                            <td>978-0-15-601219-5</td>
                        </tr>
                        <tr>
                            <th scope="row">Publisher</th>
                            <td>Harvest Books, 2000 Edition</td>
                        </tr>
                        <tr>
                            <th scope="row">Language</th>
                            <td>English</td>
                        </tr>
                        <tr>
                            <th scope="row">Format</th>
                            <td>Paperback</td>
                        </tr>
                        <tr>
                            <th scope="row">Pages</th>
                            <td>96</td>
                        </tr>
                        <tr>
                            <th scope="row">Dimensions</th>
                            <td>13.3 x 1 x 20.3 cm</td>
                        </tr>
                        <tr>
                            <th scope="row">Weight</th>
                            <td>150 g</td>
                        </tr>
                        <tr>
                            <th scope="row">Genre</th>
                            <td>Classic Fiction, Fable</td>
                        </tr>
                    </table>
                </div>
            </div>
        </section>

        <section class="reviews-section" id="reviews" aria-labelledby="reviews-heading">
            <h2 class="section-title" id="reviews-heading">Customer Reviews</h2>

            <div class="review-summary">
                <div class="summary-score">
                    <span class="score">4.6</span>
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    <p>Based on 128 reviews</p>
                </div>
                <div class="rating-bars">
                    <div class="rating-bar-row">
                        <span>5 stars</span>
                        <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 72%;"></div></div>
                        <span>72%</span>
                    </div>
                    <div class="rating-bar-row">
                        <span>4 stars</span>
                        <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 18%;"></div></div>
                        <span>18%</span>
                    </div>
                    <div class="rating-bar-row">
                        <span>3 stars</span>
                        <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 6%;"></div></div>
                        <span>6%</span>
                    </div>
                    <div class="rating-bar-row">
                        <span>2 stars</span>
                        <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 3%;"></div></div>
                        <span>3%</span>
                    </div>
                    <div class="rating-bar-row">
                        <span>1 star</span>
                        <div class="rating-bar-track"><div class="rating-bar-fill" style="width: 1%;"></div></div>
                        <span>1%</span>
                    </div>
                </div>
            </div>

            <div class="review-list">
                <article class="review-card">
                    <div class="review-header">
                        <div>
                            <span class="reviewer-name">Linh Nguyen</span>
                            <span class="verified-badge"><i class="fas fa-circle-check"></i> Verified Purchase</span>
                        </div>
                        <span class="review-date">18 July 2026</span>
                    </div>
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    <h3 class="review-title">A beautiful, quick read</h3>
                    <p class="review-body">
                        I finished this in one afternoon and it stayed with me for days. The Howard translation
                        reads very naturally in English, which made it easy for me as a second-language reader.
                    </p>
                    <div class="review-footer">
                        <button type="button" class="helpful-btn"><i class="far fa-thumbs-up"></i> Helpful (32)</button>
                    </div>
                </article>

                <article class="review-card">
                    <div class="review-header">
                        <div>
                            <span class="reviewer-name">Daniel Lee</span>
                            <span class="verified-badge"><i class="fas fa-circle-check"></i> Verified Purchase</span>
                        </div>
                        <span class="review-date">14 July 2026</span>
                    </div>
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    <h3 class="review-title">Lovely edition, small print</h3>
                    <p class="review-body">
                        The story itself is timeless and the illustrations are printed nicely. My only complaint
                        is that the text is a little small for reading before bed. Still a great gift book.
                    </p>
                    <div class="review-footer">
                        <button type="button" class="helpful-btn"><i class="far fa-thumbs-up"></i> Helpful (11)</button>
                    </div>
                </article>

                <article class="review-card">
                    <div class="review-header">
                        <div>
                            <span class="reviewer-name">Mai Hoang</span>
                        </div>
                        <span class="review-date">2 July 2026</span>
                    </div>
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    <h3 class="review-title">Re-read it as an adult and cried</h3>
                    <p class="review-body">
                        I read this as a kid and picked it up again this year. Hits completely differently as an
                        adult. Delivery was fast and the cover arrived in perfect condition.
                    </p>
                    <div class="review-footer">
                        <button type="button" class="helpful-btn"><i class="far fa-thumbs-up"></i> Helpful (8)</button>
                    </div>
                </article>
            </div>

            <div class="load-more-wrap">
                <button type="button" class="secondary-button">Load more reviews</button>
            </div>

            <div class="review-form-card" aria-labelledby="review-form-heading">
                <h2 id="review-form-heading">Write a Review</h2>
                <p>Share your thoughts with other BookNook readers.</p>
                <form id="review-form" action="product-detail" method="get">
                    <div>
                        <label for="rating-5">Your rating</label>
                        <div class="star-picker" role="radiogroup" aria-label="Star rating">
                            <input type="radio" id="rating-5" name="rating" value="5">
                            <label for="rating-5" title="5 stars">&#9733;</label>
                            <input type="radio" id="rating-4" name="rating" value="4">
                            <label for="rating-4" title="4 stars">&#9733;</label>
                            <input type="radio" id="rating-3" name="rating" value="3">
                            <label for="rating-3" title="3 stars">&#9733;</label>
                            <input type="radio" id="rating-2" name="rating" value="2">
                            <label for="rating-2" title="2 stars">&#9733;</label>
                            <input type="radio" id="rating-1" name="rating" value="1">
                            <label for="rating-1" title="1 star">&#9733;</label>
                        </div>
                    </div>
                    <div>
                        <label for="review-title">Review title</label>
                        <input type="text" id="review-title" name="title" placeholder="Sum up your review in a few words" required>
                    </div>
                    <div>
                        <label for="review-body">Your review</label>
                        <textarea id="review-body" name="body" rows="5" placeholder="What did you like or dislike about this book?" required></textarea>
                    </div>
                    <button class="button" type="submit">Submit Review</button>
                </form>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/navbar.js" defer></script>
</body>

</html>
