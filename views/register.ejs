<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookNook | Register</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/loginRegister.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <div class="auth-page">

        <div class="auth-container auth-container-wide">

            <div class="auth-card">

                <h1 class="auth-title">Create Account</h1>

                <form id="register-form" novalidate>

                    <div class="form-group">
                        <label for="fullname">Full Name</label>
                        <input type="text" id="fullname" name="fullname" placeholder="Enter your full name" minlength="2" maxlength="80" autocomplete="name" required>
                        <small id="fullname-message" aria-live="polite"></small>
                    </div>

                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" name="username" placeholder="Choose a username" minlength="3" maxlength="24" pattern="[A-Za-z0-9_]+" autocomplete="username" required>
                        <small id="username-message" aria-live="polite"></small>
                    </div>

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email" maxlength="120" autocomplete="email" required>
                        <small id="email-message" aria-live="polite"></small>
                    </div>


                    <div class="form-group">
                        <label for="introduction">Introduction</label>
                        <textarea name="introduction" id="introduction" maxlength="300"
                            placeholder="I like the web."></textarea>
                        <small id="introduction-count">0 / 300 characters</small>
                    </div>

                    <section class="security-question-section" aria-labelledby="security-question-heading">
                        <h2 id="security-question-heading">Security Questions</h2>
                        <p>Your answers will be required if you need to reset your password. Answers are not case-sensitive.</p>

                        <% securityQuestions.forEach((question, index) => { %>
                            <div class="form-group">
                                <label for="security-answer-<%= index + 1 %>"><%= index + 1 %>. <%= question %></label>
                                <input type="password" id="security-answer-<%= index + 1 %>"
                                    name="securityAnswer<%= index + 1 %>" minlength="2" maxlength="80"
                                    autocomplete="off" placeholder="Enter your answer" required>
                                <small id="security-answer-<%= index + 1 %>-message" aria-live="polite"></small>
                            </div>
                        <% }); %>
                    </section>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" name="password" placeholder="Create a password" minlength="8" autocomplete="new-password" required>
                        <small id="password-message" aria-live="polite"></small>
                    </div>

                    <div class="form-group">
                        <label for="confirm-password">Confirm Password</label>
                        <input type="password" id="confirm-password" name="confirmPassword" placeholder="Confirm your password" minlength="8" autocomplete="new-password" required>
                        <small id="confirm-password-message" aria-live="polite"></small>
                    </div>
                    <p id="form-message" aria-live="polite"></p>
                    <button type="submit" class="auth-btn button-primary">Create Account</button>
                </form>
                <div class="auth-text">
                    Already have an account?
                    <a href="/login">Sign In</a>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/navbar.js"></script>
    <script src="/js/register.js"></script>
    <script src="https://kit.fontawesome.com/6416005539.js" crossorigin="anonymous"></script>

    <%- include("partials/footer") %>
</body>

</html>
