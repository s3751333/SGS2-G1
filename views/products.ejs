<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse books and board games on BookNook, and read reviews before you buy.">
    <title>BookNook | Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/products.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <div class="page-heading">
            <div>
                <h1>Shop</h1>
                <p>Browse books and board games, and check reviews before you buy.</p>
            </div>
            <a href="wishlist" class="wishlist-link"><i class="fas fa-heart"></i> My Wishlist</a>
        </div>

        <div class="shop-tools">
            <div class="form-field search-field">
                <label for="shop-search">Search products</label>
                <input type="text" id="shop-search" placeholder="Try: The Little Prince">
            </div>
            <div class="form-field">
                <label for="shop-category">Category</label>
                <select id="shop-category">
                    <option value="all">All categories</option>
                    <option value="fiction">Fiction</option>
                    <option value="self-help">Self-Help</option>
                    <option value="reference">Reference</option>
                    <option value="board-games">Board Games</option>
                </select>
            </div>
            <button type="button">Search</button>
        </div>

        <h2 class="section-title" id="books">Featured Books</h2>
        <div class="product-grid">
            <article class="product-card">
                <img src="img/harry_potter.jpg" alt="Cover of Harry Potter and the Sorcerer's Stone">
                <span class="tag">Fantasy</span>
                <h3><a href="product-detail">Harry Potter and the Sorcerer's Stone</a></h3>
                <p class="card-meta">Author: J. K. Rowling</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    4.7 &middot; 210 reviews
                </a>
                <p class="card-price">150,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>

            <article class="product-card">
                <img src="img/little_prince.jpg" alt="Cover of The Little Prince">
                <span class="tag">Fiction</span>
                <h3><a href="product-detail">The Little Prince</a></h3>
                <p class="card-meta">Author: Antoine de Saint-Exupéry</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    4.6 &middot; 128 reviews
                </a>
                <p class="card-price">100,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>

            <article class="product-card">
                <img src="img/eng_use.jpg" alt="Cover of English Grammar in Use">
                <span class="tag">Reference</span>
                <h3><a href="product-detail">English Grammar in Use</a></h3>
                <p class="card-meta">Author: Raymond Murphy</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                    4.8 &middot; 96 reviews
                </a>
                <p class="card-price">180,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>
        </div>

        <h2 class="section-title" id="board-games">Featured Board Games</h2>
        <div class="product-grid">
            <article class="product-card">
                <img src="img/catan_bg.jpg" alt="Catan board game box">
                <span class="tag">Board Games</span>
                <h3><a href="product-detail">Catan</a></h3>
                <p class="card-meta">Players: 3&ndash;4</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    4.5 &middot; 54 reviews
                </a>
                <p class="card-price">200,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>

            <article class="product-card">
                <img src="img/monopoly.jpg" alt="Monopoly board game box">
                <span class="tag">Board Games</span>
                <h3><a href="product-detail">Monopoly</a></h3>
                <p class="card-meta">Players: 2&ndash;8</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9734;&#9734;</span>
                    3.9 &middot; 73 reviews
                </a>
                <p class="card-price">350,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>

            <article class="product-card">
                <img src="img/uno.jpg" alt="Uno card game box">
                <span class="tag">Board Games</span>
                <h3><a href="product-detail">Uno</a></h3>
                <p class="card-meta">Players: 2&ndash;10</p>
                <a class="card-rating" href="product-detail#reviews">
                    <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
                    4.4 &middot; 68 reviews
                </a>
                <p class="card-price">100,000 VND</p>
                <div class="card-actions">
                    <a href="cart" class="button"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                    <a href="wishlist" class="secondary-button"><i class="fas fa-heart"></i></a>
                </div>
            </article>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/navbar.js" defer></script>
</body>

</html>
