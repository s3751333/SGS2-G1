<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse books and board games on BookNook, and read reviews before you buy.">
    <title>BookNook | Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/products.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <div class="page-heading">
            <div>
                <h1>Shop</h1>
                <p>Browse books and board games, and check reviews before you buy.</p>
            </div>
            <a href="/wishlist" class="wishlist-link"><i class="fas fa-heart"></i> My Wishlist</a>
        </div>

        <form class="shop-tools" id="shop-controls" method="get" action="/products">
            <div class="form-field search-field">
                <label for="shop-search">Search products</label>
                <input type="text" id="shop-search" name="q" placeholder="Try: The Little Prince" value="<%= query %>">
            </div>
            <div class="form-field">
                <label for="shop-category">Category</label>
                <select id="shop-category" name="category">
                    <option value="all" <%= category === "all" ? "selected" : "" %>>All categories</option>
                    <% productCategories.forEach((cat) => { %>
                        <option value="<%= cat %>" <%= category === cat ? "selected" : "" %>><%= cat.replace("-", " ").replace(/\b\w/g, (c) => c.toUpperCase()) %></option>
                    <% }) %>
                </select>
            </div>
            <div class="form-field">
                <label for="shop-sort">Sort by</label>
                <select id="shop-sort" name="sort">
                    <option value="recent" <%= sort === "recent" ? "selected" : "" %>>Featured</option>
                    <option value="price-low" <%= sort === "price-low" ? "selected" : "" %>>Price: low to high</option>
                    <option value="price-high" <%= sort === "price-high" ? "selected" : "" %>>Price: high to low</option>
                    <option value="name" <%= sort === "name" ? "selected" : "" %>>Name (A&ndash;Z)</option>
                    <option value="rating" <%= sort === "rating" ? "selected" : "" %>>Highest rated</option>
                </select>
            </div>
            <button type="submit">Search</button>
            <button type="button" id="reset-shop-filters">Reset</button>
        </form>
        <p id="shop-results-message" class="results-message" role="status"><%= resultCount %> product<%= resultCount === 1 ? "" : "s" %> found.</p>

        <div class="product-grid" id="product-grid">
            <% if (products.length === 0) { %>
                <p class="no-results">No products match your search. Try a different keyword or category.</p>
            <% } %>
            <% products.forEach((product) => { %>
                <article
                    class="product-card"
                    data-product-id="<%= product.id %>"
                    data-search="<%= `${product.name} ${product.meta} ${product.tag}`.toLowerCase() %>"
                    data-category="<%= product.category %>"
                    data-price="<%= product.price %>"
                    data-name="<%= product.name %>"
                    data-rating="<%= product.rating.average %>"
                >
                    <img src="<%= product.image %>" alt="Cover of <%= product.name %>">
                    <span class="tag"><%= product.tag %></span>
                    <h3><a href="/product-detail/<%= product.id %>"><%= product.name %></a></h3>
                    <p class="card-meta"><%= product.metaLabel %>: <%= product.meta %></p>
                    <a class="card-rating" href="/product-detail/<%= product.id %>#reviews">
                        <% if (product.rating.count > 0) { %>
                            <span class="stars" aria-hidden="true"><%- "&#9733;".repeat(Math.round(product.rating.average)) + "&#9734;".repeat(5 - Math.round(product.rating.average)) %></span>
                            <%= product.rating.average %> &middot; <%= product.rating.count %> review<%= product.rating.count === 1 ? "" : "s" %>
                        <% } else { %>
                            No reviews yet
                        <% } %>
                    </a>
                    <p class="card-price"><%= product.price.toLocaleString("vi-VN") %> VND</p>
                    <div class="card-actions">
                        <a href="/cart" class="button" data-add-to-cart="<%= product.id %>"><i class="fas fa-cart-plus"></i> Add to Cart</a>
                        <% if (currentUser) { %>
                            <a href="/product-detail/<%= product.id %>#write-review" class="secondary-button" aria-label="View <%= product.name %> and add to wishlist"><i class="far fa-heart"></i></a>
                        <% } else { %>
                            <a href="/login?next=<%= encodeURIComponent(`/product-detail/${product.id}`) %>" class="secondary-button" aria-label="Sign in to save to wishlist"><i class="far fa-heart"></i></a>
                        <% } %>
                    </div>
                </article>
            <% }) %>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/store.js" defer></script>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/products.js" defer></script>
</body>

</html>
