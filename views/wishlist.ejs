<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Your saved BookNook items, ready to move to your cart anytime.">
    <title>BookNook | My Wishlist</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/wishlist.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> / <a href="/profile">My Account</a> / Wishlist
        </nav>

        <div class="page-heading">
            <div>
                <h1>My Wishlist</h1>
                <p>Items you've saved for later. Move them to your cart whenever you're ready.</p>
            </div>
            <div class="wishlist-tools">
                <label for="sort-wishlist">Sort by</label>
                <select id="sort-wishlist" name="sort-wishlist" data-wishlist-sort>
                    <option value="recent" <%= sort === "recent" ? "selected" : "" %>>Recently added</option>
                    <option value="price-low" <%= sort === "price-low" ? "selected" : "" %>>Price: low to high</option>
                    <option value="price-high" <%= sort === "price-high" ? "selected" : "" %>>Price: high to low</option>
                    <option value="name" <%= sort === "name" ? "selected" : "" %>>Name (A&ndash;Z)</option>
                </select>
            </div>
        </div>

        <p class="wishlist-count" data-wishlist-count-text><strong><%= items.length %> item<%= items.length === 1 ? "" : "s" %></strong> saved to your wishlist</p>

        <section class="wishlist-grid" id="wishlist-grid" aria-label="Saved items" <%= items.length === 0 ? "hidden" : "" %>>
            <% items.forEach((item) => { %>
                <article class="wishlist-card" data-wishlist-card data-product-id="<%= item.productId %>">
                    <button type="button" class="remove-btn" data-remove-wishlist data-product-id="<%= item.productId %>" aria-label="Remove <%= item.product.name %> from wishlist"><i class="fas fa-xmark"></i></button>
                    <img src="<%= item.product.image %>" alt="Cover of <%= item.product.name %>">
                    <span class="tag"><%= item.product.tag %></span>
                    <h3><a href="/product-detail/<%= item.product.id %>"><%= item.product.name %></a></h3>
                    <p class="card-author"><%= item.product.meta %></p>
                    <p class="card-price"><%= item.product.price.toLocaleString("vi-VN") %> VND</p>
                    <% if (item.product.stock > 5) { %>
                        <p class="card-stock in-stock"><i class="fas fa-circle-check"></i> In stock</p>
                    <% } else if (item.product.stock > 0) { %>
                        <p class="card-stock low-stock"><i class="fas fa-triangle-exclamation"></i> Only <%= item.product.stock %> left</p>
                    <% } else { %>
                        <p class="card-stock low-stock"><i class="fas fa-circle-xmark"></i> Out of stock</p>
                    <% } %>
                    <p class="social-proof">
                        <i class="fas fa-heart"></i>
                        <% if (item.othersCount > 0) { %>
                            Saved by <%= item.othersCount %> other collector<%= item.othersCount === 1 ? "" : "s" %>
                        <% } else { %>
                            You're the first to save this item
                        <% } %>
                    </p>
                    <div class="card-actions">
                        <button type="button" class="button" data-move-to-cart data-product-id="<%= item.product.id %>"><i class="fas fa-cart-plus"></i> Move to Cart</button>
                    </div>
                </article>
            <% }) %>
        </section>

        <div class="empty-wishlist" id="empty-wishlist" <%= items.length === 0 ? "" : "hidden" %>>
            <p>Your wishlist is empty. Browse the shop and tap the heart icon on any item to save it here.</p>
            <a href="/products" class="button">Browse Shop</a>
        </div>
    </main>
    <%- include("partials/footer") %>

    <script src="/js/store.js" defer></script>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/wishlist.js" defer></script>
</body>

</html>
