<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookNook | Reset Password</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/loginRegister.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="auth-page">
        <div class="auth-container">
            <div class="auth-card">
                <h1 class="auth-title">Reset Password</h1>

                <% if (tokenIsValid) { %>
                    <p class="auth-description">Your security answers were correct. Choose a new password for your account.</p>
                    <form id="reset-password-form" data-token="<%= token %>" novalidate>
                        <div class="form-group">
                            <label for="new-password">New Password</label>
                            <input type="password" id="new-password" name="password" minlength="8"
                                autocomplete="new-password" required>
                            <small id="new-password-error" aria-live="polite"></small>
                        </div>

                        <div class="form-group">
                            <label for="confirm-new-password">Confirm New Password</label>
                            <input type="password" id="confirm-new-password" name="confirmPassword" minlength="8"
                                autocomplete="new-password" required>
                            <small id="confirm-new-password-error" aria-live="polite"></small>
                        </div>

                        <p id="reset-password-message" aria-live="polite"></p>
                        <button type="submit" class="auth-btn">Change Password</button>
                    </form>
                <% } else { %>
                    <p class="auth-description auth-error">This password reset session is invalid or has expired.</p>
                    <div class="auth-text"><a href="/forgot-password">Answer the security questions again</a></div>
                <% } %>
            </div>
        </div>
    </main>

    <%- include("partials/footer") %>
    <script src="/js/navbar.js"></script>
    <% if (tokenIsValid) { %>
        <script src="/js/reset-password.js"></script>
    <% } %>
    <script src="https://kit.fontawesome.com/6416005539.js" crossorigin="anonymous"></script>
</body>

</html>
