<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="View and edit your BookNook account profile.">
    <title>BookNook | My Profile</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/profile.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a> / My Account / Profile
        </nav>

        <div class="page-heading">
            <h1>My Profile</h1>
            <p>View and update your personal information.</p>
        </div>

        <div class="profile-layout">
            <aside class="profile-card">
                <div class="avatar-wrap">
                    <% if (currentUser.avatarImage) { %>
                        <img class="avatar-placeholder avatar-photo" src="/<%= currentUser.avatarImage %>" alt="<%= currentUser.fullName %>'s profile photo">
                    <% } else if (currentUser.avatarColor) { %>
                        <div class="avatar-placeholder" style="background-color: <%= currentUser.avatarColor %>; color: #ffffff; border-style: solid;" aria-label="Profile avatar initials">
                            <%= currentUser.fullName.split(" ").map((part) => part[0]).slice(0, 2).join("").toUpperCase() %>
                        </div>
                    <% } else { %>
                        <div class="avatar-placeholder" aria-label="No profile photo set">
                            <i class="fas fa-user"></i>
                        </div>
                    <% } %>
                </div>
                <h2><%= currentUser.fullName %></h2>
                <p class="member-since">@<%= currentUser.username %> &middot; <%= currentUser.role === "admin" ? "Administrator" : "Member" %></p>

                <nav class="profile-quick-links" aria-label="Account shortcuts">
                    <a href="/wishlist"><i class="fas fa-heart"></i> My Wishlist</a>
                    <a href="/cart"><i class="fas fa-shopping-cart"></i> My Cart</a>
                    <a href="#account-actions"><i class="fas fa-gear"></i> Account Settings</a>
                </nav>
            </aside>

            <div class="profile-main">
                <section class="info-card" aria-labelledby="info-heading">
                    <h2 id="info-heading">Personal Information</h2>
                    <p>This information is only visible to you.</p>

                    <% if (profileSaved) { %>
                        <p class="form-success" role="status">Your profile has been updated.</p>
                    <% } %>

                    <form id="profile-form" action="/profile" method="post" enctype="multipart/form-data" novalidate>
                        <div class="full-field">
                            <label for="avatar-file">Profile picture</label>
                            <input type="file" id="avatar-file" name="avatarFile" accept="image/jpeg,image/png,image/gif,image/webp">
                            <p class="field-error" data-error-for="avatarImage"><%= profileErrors.avatarImage || "" %></p>
                            <% if (currentUser.avatarImage) { %>
                                <label class="remove-photo-option">
                                    <input type="checkbox" name="removeAvatarImage">
                                    Remove current photo and use a colour avatar instead
                                </label>
                            <% } %>
                        </div>

                        <div class="full-field">
                            <span>Avatar colour <% if (currentUser.avatarImage) { %>(used if you remove your photo)<% } %></span>
                            <div class="avatar-picker" role="radiogroup" aria-label="Avatar colour">
                                <% avatarColors.forEach((color, index) => { %>
                                    <input type="radio" id="avatar-<%= index %>" name="avatarColor" value="<%= color %>" <%= (currentUser.avatarColor || avatarColors[0]) === color ? "checked" : "" %>>
                                    <label for="avatar-<%= index %>" style="background-color: <%= color %>;" title="<%= color %>"></label>
                                <% }) %>
                            </div>
                        </div>

                        <div class="full-field">
                            <label for="full-name">Full name</label>
                            <input type="text" id="full-name" name="fullName" value="<%= currentUser.fullName %>" maxlength="80" required>
                            <p class="field-error" data-error-for="fullName"><%= profileErrors.fullName || "" %></p>
                        </div>

                        <div class="full-field">
                            <label for="email">Email address</label>
                            <input type="email" id="email" name="email" value="<%= currentUser.email %>" required>
                            <p class="field-error" data-error-for="email"><%= profileErrors.email || "" %></p>
                        </div>

                        <div class="full-field">
                            <label for="introduction">Introduction</label>
                            <textarea id="introduction" name="introduction" rows="3" maxlength="300" placeholder="Tell other members a little about yourself"><%= currentUser.introduction || "" %></textarea>
                            <p class="field-error" data-error-for="introduction"><%= profileErrors.introduction || "" %></p>
                        </div>

                        <div class="form-actions">
                            <button type="reset" class="secondary-button">Cancel</button>
                            <button type="submit" class="button">Save Changes</button>
                        </div>
                    </form>
                </section>

                <section class="account-actions-card" id="account-actions" aria-labelledby="actions-heading">
                    <h2 id="actions-heading">Account Settings</h2>
                    <p>Manage your password and account access.</p>

                    <% if (passwordSaved) { %>
                        <p class="form-success" role="status">Your password has been changed.</p>
                    <% } %>

                    <form id="password-form" action="/profile/password" method="post" novalidate>
                        <div class="full-field">
                            <label for="current-password">Current password</label>
                            <input type="password" id="current-password" name="currentPassword" required>
                            <p class="field-error" data-error-for="currentPassword"><%= passwordErrors.currentPassword || "" %></p>
                        </div>
                        <div class="full-field">
                            <label for="new-password">New password</label>
                            <input type="password" id="new-password" name="newPassword" minlength="8" required>
                            <p class="field-error" data-error-for="newPassword"><%= passwordErrors.newPassword || "" %></p>
                        </div>
                        <div class="full-field">
                            <label for="confirm-password">Confirm new password</label>
                            <input type="password" id="confirm-password" name="confirmPassword" minlength="8" required>
                            <p class="field-error" data-error-for="confirmPassword"><%= passwordErrors.confirmPassword || "" %></p>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="secondary-button">Change Password</button>
                        </div>
                    </form>

                    <div class="account-action-row">
                        <div>
                            <h3>Log out</h3>
                            <p>Sign out of BookNook on this device.</p>
                        </div>
                        <button type="button" id="profile-logout-button" class="secondary-button">Log Out</button>
                    </div>

                    <div class="account-action-row danger">
                        <div>
                            <h3>Deactivate account</h3>
                            <p>Your account will be locked and you'll be signed out. Contact an administrator to reactivate it.</p>
                        </div>
                        <form action="/profile/deactivate" method="post" data-confirm-submit="Deactivate your account? You will be signed out immediately.">
                            <button type="submit" class="danger-button">Deactivate Account</button>
                        </form>
                    </div>
                </section>
            </div>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/navbar.js" defer></script>
    <script src="/js/profile.js" defer></script>
</body>

</html>
