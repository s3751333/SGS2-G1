<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Enter delivery and payment details to place your BookNook order.">
    <title>BookNook | Checkout</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/checkout.css">
  </head>
  <body>
    <%- include("partials/navbar", { activePage }) %>
    <main class="checkout-page">
      <h1>Checkout</h1>
      <section id="checkout-empty" class="checkout-message" hidden>
        <i class="fas fa-basket-shopping" aria-hidden="true"></i>
        <h2>There is nothing to check out</h2>
        <p>Add a product to your cart before placing an order.</p>
        <a href="/products">Browse Products</a>
      </section>
      <section id="order-confirmation" class="checkout-message confirmation" hidden>
        <i class="fas fa-circle-check" aria-hidden="true"></i>
        <h2>Order placed successfully</h2>
        <p>Your order number is <strong data-order-id></strong>.</p>
        <p>Total: <strong data-order-total></strong></p>
        <p>A confirmation has been prepared for <strong data-order-email></strong>.</p>
        <p data-bank-message hidden>Please transfer to BookNook Bank, account 0123456789, using your order number as the payment reference.</p>
        <a href="/products">Continue Shopping</a>
      </section>
      <div id="checkout-content" class="checkout-layout">
        <form id="checkout-form" class="checkout-form" action="/checkout" method="post">
          <section class="form-section">
            <h2>Shipping Information</h2>
            <div class="form-grid">
              <label class="full-field">Full name
                <input type="text" name="fullName" autocomplete="name" minlength="2" maxlength="80" required>
              </label>
              <label>Email
                <input type="email" name="email" autocomplete="email" maxlength="120" required>
              </label>
              <label>Phone number
                <input type="tel" name="phone" autocomplete="tel" pattern="[0-9+ ]{9,15}" title="Use 9 to 15 digits; spaces and + are allowed." required>
              </label>
              <label class="full-field">Address
                <input type="text" name="address" autocomplete="street-address" minlength="5" maxlength="150" required>
              </label>
              <label>City / Province
                <input type="text" name="city" autocomplete="address-level1" minlength="2" maxlength="60" required>
              </label>
              <label>District
                <input type="text" name="district" autocomplete="address-level2" minlength="2" maxlength="60" required>
              </label>
              <label class="full-field">Order note (optional)
                <textarea name="note" rows="3" maxlength="300" placeholder="Delivery instructions..."></textarea>
              </label>
            </div>
          </section>
          <section class="form-section">
            <h2>Payment Method</h2>
            <label class="payment-option">
              <input type="radio" name="payment" value="cod" checked>
              <span><strong>Cash on delivery</strong><small>Pay when your order arrives</small></span>
            </label>
            <label class="payment-option">
              <input type="radio" name="payment" value="bank">
              <span><strong>Bank transfer</strong><small>Transfer details will be shown after ordering</small></span>
            </label>
            <div id="bank-details" class="bank-details" hidden>
              <strong>BookNook Bank</strong>
              <span>Account number: 0123456789</span>
              <small>Your order number will be used as the payment reference.</small>
            </div>
          </section>
        </form>
        <aside class="order-summary checkout-summary">
          <h2>Your Order</h2>
          <div id="checkout-products"></div>
          <hr>
          <div class="summary-row"><span>Subtotal</span><strong id="checkout-subtotal">0 VND</strong></div>
          <div class="summary-row"><span>Shipping</span><strong>Free</strong></div>
          <div class="summary-row total"><span>Total</span><strong id="checkout-total">0 VND</strong></div>
          <button id="place-order-button" class="checkout-button" type="submit" form="checkout-form">Place Order</button>
          <p class="secure-note">Your information is used only to process this order.</p>
        </aside>
      </div>
    </main>
    <%- include("partials/footer") %>
    <script src="/js/store.js" defer></script>
    <script src="/js/navbar.js" defer></script>
    <script src="/js/checkout.js" defer></script>
  </body>
</html>
