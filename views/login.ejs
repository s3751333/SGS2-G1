<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookNook | Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/default.css">
    <link rel="stylesheet" href="css/navbar.css">
    <link rel="stylesheet" href="css/loginRegister.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>
    
    <div class="auth-page">

        <div class="auth-container">

            <div class="auth-card">
                <h1 class="auth-title">Login</h1>

                <form id="login-form" data-next="<%= nextPage %>" novalidate>

                    <div class="form-group">
                        <label for="login-email">Email</label>
                        <input type="email" id="login-email" name="email" placeholder="Enter your email"
                            autocomplete="email" required>
                        <small id="login-email-message" aria-live="polite"></small>
                    </div>

                    <div class="form-group">
                        <label for="login-password">Password</label>
                        <input type="password" id="login-password" name="password" placeholder="Enter your password"
                            autocomplete="current-password" required>
                        <small id="login-password-message" aria-live="polite"></small>
                    </div>

                    <label class="remember-email">
                        <input type="checkbox" id="remember-email"> Remember my email
                    </label>

                    <p class="forgot-password-link"><a href="/forgot-password">Forgot password?</a></p>

                    <p id="login-message" aria-live="polite"></p>
                    <button type="submit" class="auth-btn">Sign In</button>

                </form>

                <div class="auth-text">
                    Don't have an account?
                    <a href="/register">Register</a>
                </div>

            </div>

        </div>

    </div>

    <script src="/js/navbar.js"></script>
    <script src="/js/login.js"></script>
    <script src="https://kit.fontawesome.com/6416005539.js" crossorigin="anonymous"></script>

    <%- include("partials/footer") %>
</body>

</html>
