<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Admin-only list of BookNook users, account types and enabled status.">
    <title>SGS2-G1 | User List</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/user-list.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="admin-page">
        <div class="admin-container user-list-container">
            <section class="admin-card">
                <h1 class="admin-title">User List</h1>
                <p class="admin-description">Admin-only overview of BookNook user accounts.</p>

                <div class="table-wrapper">
                    <table class="user-table">
                        <caption>Registered users</caption>
                        <thead>
                            <tr>
                                <th scope="col">User</th>
                                <th scope="col">User Type</th>
                                <th scope="col">Status</th>
                                <th class="toggle-cell" scope="col">Enable</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Admin User</th>
                                <td>Administrator</td>
                                <td><span class="status enabled">Enabled</span></td>
                                <td class="toggle-cell"><input class="status-toggle" type="checkbox" checked
                                        aria-label="Enable Admin User"></td>
                            </tr>
                            <tr>
                                <th scope="row">Linh Nguyen</th>
                                <td>Member</td>
                                <td><span class="status enabled">Enabled</span></td>
                                <td class="toggle-cell"><input class="status-toggle" type="checkbox" checked
                                        aria-label="Enable Linh Nguyen"></td>
                            </tr>
                            <tr>
                                <th scope="row">Alex Pham</th>
                                <td>Member</td>
                                <td><span class="status disabled">Disabled</span></td>
                                <td class="toggle-cell"><input class="status-toggle" type="checkbox"
                                        aria-label="Enable Alex Pham"></td>
                            </tr>
                            <tr>
                                <th scope="row">Mai Hoang</th>
                                <td>Member</td>
                                <td><span class="status enabled">Enabled</span></td>
                                <td class="toggle-cell"><input class="status-toggle" type="checkbox" checked
                                        aria-label="Enable Mai Hoang"></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="js/user-list.js"></script>
    <script src="/js/navbar.js"></script>
    <script src="https://kit.fontawesome.com/6416005539.js" crossorigin="anonymous"></script>
</body>

</html>
