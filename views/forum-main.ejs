<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse BookNook discussions about English books, Vietnamese books and board games.">
    <title>BookNook | Discussion Forum</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="css/forum.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="page-container">
        <section class="page-heading">
            <div>
                <h1>BookNook Discussion Forum</h1>
                <p>Ask questions and share ideas about books and board games.</p>
            </div>
            <a class="button" href="forum-new-topic">Start a discussion</a>
        </section>

        <form class="forum-tools" action="forum-main" method="get" role="search">
            <div class="form-field search-field">
                <label for="forum-search">Search discussions</label>
                <input id="forum-search" name="search" type="search" placeholder="Try: fantasy books">
            </div>
            <div class="form-field">
                <label for="category-filter">Category</label>
                <select id="category-filter" name="category">
                    <option value="all">All categories</option>
                    <option value="english">English Books</option>
                    <option value="vietnamese">Vietnamese Books</option>
                    <option value="board-games">Board Games</option>
                </select>
            </div>
            <button class="button" type="submit">Search</button>
        </form>

        <section aria-labelledby="category-heading">
            <h2 id="category-heading" class="section-title">Browse by subject</h2>
            <div class="category-grid">
                <a class="category-card" href="#english-books">
                    <h3>English Books</h3>
                    <p>Kids, fiction, non-fiction and best sellers</p>
                    <span>12 discussions</span>
                </a>
                <a class="category-card" href="#vietnamese-books">
                    <h3>Vietnamese Books</h3>
                    <p>Education, novels, comics and history</p>
                    <span>9 discussions</span>
                </a>
                <a class="category-card" href="#board-games">
                    <h3>Board Games</h3>
                    <p>New, classic, debate and turn-based games</p>
                    <span>7 discussions</span>
                </a>
            </div>
        </section>

        <section aria-labelledby="discussion-heading">
            <h2 id="discussion-heading" class="section-title">Recent discussions</h2>
            <div class="topic-list">
                <article class="topic-row" id="english-books">
                    <div>
                        <span class="tag">English Books</span>
                        <h3><a href="forum-topic">Which translation of The Little Prince should I read?</a></h3>
                        <p>Started by Linh Nguyen · 18 July 2026</p>
                    </div>
                    <div class="topic-counts">
                        <span><strong>4</strong> replies</span>
                        <span><strong>31</strong> views</span>
                    </div>
                </article>

                <article class="topic-row" id="vietnamese-books">
                    <div>
                        <span class="tag">Vietnamese Books</span>
                        <h3><a href="forum-topic">Recommend a Vietnamese history book for beginners</a></h3>
                        <p>Started by Minh Tran · 17 July 2026</p>
                    </div>
                    <div class="topic-counts">
                        <span><strong>6</strong> replies</span>
                        <span><strong>42</strong> views</span>
                    </div>
                </article>

                <article class="topic-row" id="board-games">
                    <div>
                        <span class="tag">Board Games</span>
                        <h3><a href="forum-topic">Best cooperative board game for four new players?</a></h3>
                        <p>Started by Alex Pham · 16 July 2026</p>
                    </div>
                    <div class="topic-counts">
                        <span><strong>8</strong> replies</span>
                        <span><strong>57</strong> views</span>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/navbar.js"></script>
    <script src="https://kit.fontawesome.com/6416005539.js" crossorigin="anonymous"></script>
</body>

</html>
