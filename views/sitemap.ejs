<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookNook | Sitemap</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/sitemap.css">
</head>

<body>
    <%- include("partials/navbar", { activePage }) %>

    <main class="sitemap-container">
        <div class="sitemap-header">
            <h1>Sitemap</h1>
            <p>Explore BookNook's main pages, current blog articles, and public discussion topics.</p>
        </div>

        <div class="sitemap-grid" aria-label="BookNook website sections">
            <% sitemapSections.forEach((section) => { %>
                <section class="sitemap-card" aria-labelledby="<%= section.id %>-heading">
                    <h2 id="<%= section.id %>-heading">
                        <i class="<%= section.icon %>" aria-hidden="true"></i>
                        <%= section.title %>
                    </h2>
                    <ul class="sitemap-list">
                        <% section.links.forEach((link) => { %>
                            <li><a href="<%= link.url %>"><%= link.label %></a></li>
                        <% }) %>
                    </ul>
                </section>
            <% }) %>
        </div>
    </main>

    <%- include("partials/footer") %>

    <script src="/js/navbar.js"></script>

</body>

</html>
